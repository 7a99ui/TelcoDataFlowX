<configuration>
    <!-- S3A FileSystem -->
    <property>
        <name>fs.s3a.impl</name>
        <value>org.apache.hadoop.fs.s3a.S3AFileSystem</value>
    </property>

    <!-- Credentials -->
    <property>
        <name>fs.s3a.access.key</name>
        <value>minio</value>
    </property>
    <property>
        <name>fs.s3a.secret.key</name>
        <value>minio123</value>
    </property>

    <!-- Endpoint pour MinIO -->
    <property>
        <name>fs.s3a.endpoint</name>
        <value>http://minio1:9000</value>
    </property>

    <!-- Options supplémentaires pour performance/stabilité -->
    <property>
        <name>fs.s3a.path.style.access</name>
        <value>true</value>
    </property>
</configuration>
